NODE_ENV=development
DATABASE_URL=postgres://bc5000:bc5000@localhost:5432/bc5000

# Cognito remains the external identity provider. AWS application hosting and
# Secrets Manager are not part of the AccountPulse OVH runtime.
AWS_REGION=ap-southeast-2
COGNITO_USER_POOL_ID=ap-southeast-2_example
COGNITO_CLIENT_ID=example-client-id
COGNITO_DOMAIN=https://example.auth.ap-southeast-2.amazoncognito.com
COGNITO_ISSUER=https://cognito-idp.ap-southeast-2.amazonaws.com/ap-southeast-2_example
COGNITO_REDIRECT_URI=http://localhost:3000/auth/callback
SESSION_SECRET_BASE64=replace-with-32-byte-base64-value

PUBLIC_BASE_URL=http://localhost:3000
WEBHOOK_PUBLIC_BASE_URL=https://example.invalid

# Standard Xero OAuth. The encryption JSON maps key IDs to 32-byte base64 keys.
XERO_OAUTH_CLIENT_ID=replace-me
XERO_OAUTH_CLIENT_SECRET=replace-me
XERO_OAUTH_REDIRECT_URI=http://localhost:3000/xero/callback
XERO_TOKEN_ENCRYPTION_KEYS_JSON={"local-primary":"replace-with-32-byte-base64-value"}
XERO_TOKEN_ACTIVE_KEY_ID=local-primary
XERO_WEBHOOK_KEY=replace-me

# Temporary legacy Custom Connection compatibility for existing internal tenants.
XERO_API_CREDENTIALS={"clientId":"replace-me","clientSecret":"replace-me"}

# Stripe Billing values are consumed by the web application only.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_SOLO_PRICE_ID=price_replace_me
STRIPE_PORTAL_CONFIGURATION_ID=bpc_replace_me

# Sinch delivery and webhook verification use hosting-neutral environment values.
SINCH_API_CREDENTIALS={"apiKey":"replace-me","apiSecret":"replace-me"}
SINCH_CALLBACK_PUBLIC_KEYS_JSON={}
SINCH_WEBHOOK_TOKEN=replace-me
# Existing Motts INTERNAL_LEGACY organisation only; never point this at Solo.
WEBHOOK_ORGANISATION_ID=
# Required before commercial cancellation handling is enabled. Set only to the
# provider/legal-approved period; AccountPulse deliberately has no guessed default.
SMS_NUMBER_QUARANTINE_DAYS=replace-with-approved-whole-days

SEND_MODE=dry-run
LIVE_SEND_ACK=
ALLOWED_RECIPIENTS=+61400000000
LOG_LEVEL=info
VOICE_QUEUE_AGE_ALARM_SECONDS=300
RETELL_WEBHOOK_LAG_ALARM_SECONDS=300
RETELL_SIGNATURE_FAILURE_ALARM_COUNT=3
ACCOUNT_PULSE_VOICE_GATEWAY_IMAGE=
ACCOUNT_PULSE_ASTERISK_IMAGE=
VOICE_GATEWAY_SIGNING_SECRET=
VOICE_GATEWAY_URL=http://voice-gateway:3105
VOICE_GATEWAY_ACCEPT_CALLS=false
VOIPCLOUD_API_KEY=
VOIPCLOUD_SIP_SERVER=
VOIPCLOUD_SIP_USER_NUMBER=
VOIPCLOUD_SIP_PASSWORD=
ASTERISK_ARI_USERNAME=accountpulse_gateway
ASTERISK_ARI_PASSWORD=
ASTERISK_EXTERNAL_ADDRESS=
VOICE_SIP_BIND_IP=
VOICE_RTP_BIND_IP=
VOICE_OFFICE_QUEUE_EXTENSION=1003
VOICE_OFFICE_NUMBER_E164=+61350324518
