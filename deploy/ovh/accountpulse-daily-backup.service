[Unit]
Description=Create a bounded age-encrypted AccountPulse PostgreSQL backup
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
EnvironmentFile=/etc/accountpulse/daily-backup.env
ExecStart=/usr/local/libexec/accountpulse/owner-recurring-backup create
TimeoutStartSec=17min
UMask=0077
Nice=10
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
PrivateNetwork=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/accountpulse/backup-export
RestrictAddressFamilies=AF_UNIX
LockPersonality=true
