# Copy to the protected OVH environment file outside the Git checkout.
# Replace every `replace-me` value. Never commit the populated file.

# Immutable release images
ACCOUNT_PULSE_WEB_IMAGE=accountpulse-web:replace-with-git-sha
ACCOUNT_PULSE_WORKER_IMAGE=accountpulse-worker:replace-with-git-sha
ACCOUNT_PULSE_ASTERISK_IMAGE=accountpulse-asterisk:replace-with-git-sha
ACCOUNT_PULSE_VOICE_GATEWAY_IMAGE=accountpulse-voice-gateway:replace-with-git-sha

# Application and PostgreSQL
NODE_ENV=production
PUBLIC_BASE_URL=https://ap.motts.com.au
ACCOUNT_PULSE_LEGAL_ENTITY="Swan Hill Appliance Repairs Pty Ltd"
ACCOUNT_PULSE_SUPPORT_EMAIL=ap@motts.com.au
DATABASE_NAME=accountpulse
DATABASE_USER=accountpulse
DATABASE_PASSWORD=replace-me
DATABASE_URL=postgresql://accountpulse:replace-me@postgres:5432/accountpulse
SEND_MODE=approval

# Cognito identity only; AccountPulse application services remain on OVH.
AWS_REGION=ap-southeast-2
COGNITO_DOMAIN=https://replace-me.auth.ap-southeast-2.amazoncognito.com
COGNITO_REDIRECT_URI=https://ap.motts.com.au/auth/callback
COGNITO_ISSUER=https://cognito-idp.ap-southeast-2.amazonaws.com/replace-me
COGNITO_CLIENT_ID=replace-me
COGNITO_USER_POOL_ID=replace-me
SESSION_SECRET_BASE64=replace-with-32-byte-base64-value

# Standard Xero OAuth and versioned AES-256-GCM refresh-token encryption
XERO_OAUTH_CLIENT_ID=replace-me
XERO_OAUTH_CLIENT_SECRET=replace-me
XERO_OAUTH_REDIRECT_URI=https://ap.motts.com.au/xero/callback
XERO_TOKEN_ENCRYPTION_KEYS_JSON={"primary":"replace-with-32-byte-base64-value"}
XERO_TOKEN_ACTIVE_KEY_ID=primary
XERO_WEBHOOK_KEY=replace-me

# Existing internal Custom Connection fallback; remove only after approved cutover.
XERO_API_CREDENTIALS={"clientId":"replace-me","clientSecret":"replace-me"}

# Stripe Billing (web container only)
STRIPE_SECRET_KEY=sk_live_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_SOLO_MONTHLY_PRICE_ID=price_replace_me
STRIPE_SOLO_ANNUAL_PRICE_ID=price_replace_me
STRIPE_PORTAL_CONFIGURATION_ID=bpc_replace_me

# Sinch delivery and inbound verification
SINCH_API_CREDENTIALS={"apiKey":"replace-me","apiSecret":"replace-me"}
SINCH_CALLBACK_PUBLIC_KEYS_JSON={}
SINCH_WEBHOOK_TOKEN=replace-me
# Existing Motts INTERNAL_LEGACY organisation only, to constrain legacy reply metadata.
WEBHOOK_ORGANISATION_ID=replace-with-existing-motts-organisation-uuid
# Obtain this whole-day period from the signed provider/legal policy.
SMS_NUMBER_QUARANTINE_DAYS=replace-with-approved-whole-days
# Replace with the approved Australia/Sydney public-holiday calendar, keep
# dates unique, and update the list before each calendar year.
DEBT_CONTACT_HOLIDAY_DATES_JSON=["2027-01-01","2027-01-26","2027-12-25"]

# Native VoIPcloud capability remains disabled until explicitly enabled.
VOICE_GATEWAY_URL=http://voice-gateway:3105
VOICE_GATEWAY_SIGNING_SECRET=replace-me
VOICE_GATEWAY_ACCEPT_CALLS=false
VOIPCLOUD_API_KEY=replace-me
VOIPCLOUD_API_USER_NUMBER=replace-me
VOIPCLOUD_SIP_SERVER=sipm2.au.voipcloud.online:7060
VOIPCLOUD_SIP_DOMAIN=sipm2.au.voipcloud.online
VOIPCLOUD_SIP_USER_NUMBER=replace-me
VOIPCLOUD_SIP_PASSWORD=replace-me
ASTERISK_ARI_USERNAME=accountpulse_gateway
ASTERISK_ARI_PASSWORD=replace-me
# Documentation-only TEST-NET-3 address; replace with the OVH public IP.
ASTERISK_EXTERNAL_ADDRESS=203.0.113.10
VOICE_SIP_BIND_IP=203.0.113.10
VOICE_RTP_BIND_IP=203.0.113.10
VOICE_OFFICE_QUEUE_EXTENSION=1003
VOICE_OFFICE_NUMBER_E164=replace-me

# Operational monitor thresholds
VOICE_QUEUE_AGE_ALARM_SECONDS=300
RETELL_WEBHOOK_LAG_ALARM_SECONDS=300
RETELL_SIGNATURE_FAILURE_ALARM_COUNT=3
